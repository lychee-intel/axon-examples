<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AxonProjectPath Condition="'$(AxonProjectPath)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\axon\bindings\dotnet\Axon\Axon.csproj')">$(MSBuildThisFileDirectory)..\..\..\axon\bindings\dotnet\Axon\Axon.csproj</AxonProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <ProjectReference Include="$(AxonProjectPath)" Condition="'$(AxonProjectPath)' != ''" />
    <PackageReference Include="Axon" Version="0.10.0" Condition="'$(AxonProjectPath)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the source files directly to avoid WinForms/ScottPlot dependency in tests -->
    <Compile Include="..\src\WaveformBuffer.cs" Link="WaveformBuffer.cs" />
    <Compile Include="..\src\SimulatorControlState.cs" Link="SimulatorControlState.cs" />
    <Compile Include="..\src\CollectionSessionStartup.cs" Link="CollectionSessionStartup.cs" />
  </ItemGroup>

</Project>
