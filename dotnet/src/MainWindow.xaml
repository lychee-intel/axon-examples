<Window x:Class="LycheeMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:LycheeMonitor"
        Title="Axon · Lychee EEG Monitor"
        Background="#10151b"
        MinWidth="920" MinHeight="600"
        Width="1100" Height="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <DockPanel.Resources>
            <local:InvertBoolConverter x:Key="InvertBool"/>
            <Style x:Key="DarkCombo" TargetType="ComboBox">
                <Setter Property="Background" Value="#1a2230"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#2b6245"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="2">
                                                <Path Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Data="M 0 0 L 8 0 L 4 4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="8,0,26,0"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Grid MinWidth="{TemplateBinding ActualWidth}" SnapsToDevicePixels="True">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="2"/>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GreenButton" TargetType="Button">
                <Setter Property="Background" Value="#256d4a"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource GreenButton}">
                <Setter Property="Background" Value="#8c3039"/>
            </Style>
        </DockPanel.Resources>

        <!-- Top controls -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="14,12,14,8">
            <TextBlock Text="Sensor:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="DevicePicker"
                      Width="340"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      IsEnabled="{Binding IsCollecting, Converter={StaticResource InvertBool}}"
                      Style="{StaticResource DarkCombo}"/>
            <Button Content="Start"
                    Width="90" Height="28"
                    Margin="8,0,8,0"
                    Command="{Binding StartCollectionCommand}"
                    IsEnabled="{Binding IsCollecting, Converter={StaticResource InvertBool}}"
                    Style="{StaticResource GreenButton}"/>
            <Button Content="Stop"
                    Width="90" Height="28"
                    Margin="0,0,16,0"
                    Command="{Binding StopCollectionCommand}"
                    IsEnabled="{Binding IsCollecting}"
                    Style="{StaticResource RedButton}"/>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#80a897"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Footer -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding FooterText}"
                   Foreground="#6da886"
                   Margin="14,0,14,12"/>

        <!-- ScottPlot chart -->
        <ScottPlot:WpfPlot x:Name="PlotView"
                           Background="#07120d"/>
    </DockPanel>
</Window>
